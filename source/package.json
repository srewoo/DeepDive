{
  "name": "deep-dive",
  "private": true,
  "description": "A procedural underwater world rendered with WebGPU, bundled into one HTML file",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:readable": "node build.mjs --readable",
    "build:dev": "node build.mjs --dev",
    "build:extension": "node build.mjs --extension",
    "package:extension": "node build.mjs --extension --zip",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
